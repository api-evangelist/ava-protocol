{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ava Protocol AVS Auth Secrets API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Secrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List secrets (metadata only — values are never echoed)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.avaprotocol.org/api/v1/secrets",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "query"
              },
              {
                "name": "orgId",
                "value": "",
                "type": "query"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Cursor — return items immediately before this position (backward pagination)."
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor — return items immediately after this position (forward pagination)."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Max items to return. Default 20; server-enforced ceiling applies."
              }
            ]
          },
          "docs": "List secrets (metadata only — values are never echoed)"
        },
        {
          "info": {
            "name": "Create or replace a secret (idempotent)",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://gateway.avaprotocol.org/api/v1/secrets/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create or replace a secret (idempotent)"
        },
        {
          "info": {
            "name": "Delete a secret",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://gateway.avaprotocol.org/api/v1/secrets/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "workflowId",
                "value": "",
                "type": "query"
              },
              {
                "name": "orgId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Delete a secret"
        }
      ]
    }
  ],
  "bundled": true
}